# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: used only if Gemini rejects the main key (revoked, expired). Not for spreading quota.
GEMINI_API_KEY_BACKUP=
# Fast and on the free tier. A heavier model was ~6x slower in testing (22 s per photo).
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3001
