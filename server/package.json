{
  "name": "trimtl-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate-rules": "tsx scripts/validate-rules.ts",
    "lint-docs": "tsx scripts/check-docs.ts",
    "sync-shared": "tsx scripts/shared.ts sync",
    "check-shared": "tsx scripts/shared.ts check",
    "check-secrets": "tsx scripts/check-secrets.ts",
    "check": "npm run typecheck && npm run validate-rules && npm test && npm run lint-docs && npm run check-shared && npm run check-secrets"
  },
  "engines": { "node": ">=20.6" },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
