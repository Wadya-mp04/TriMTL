# Copy to mobile/.env (git-ignored). Never put the Gemini key here (that lives in server/.env).
# Supabase: Project Settings -> API. Only the publishable (anon) key, never the secret/service-role key.
# Leave both empty to run the app in demo mode without accounts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# TriMTL server: its public HTTPS URL (Cloudflare tunnel or deployed host), no trailing slash.
# Leave empty only if phone and laptop share a Wi-Fi that allows device-to-device traffic.
EXPO_PUBLIC_API_URL=
