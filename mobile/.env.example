# Copy to mobile/.env (git-ignored). Supabase dashboard -> Project Settings -> API.
# Only the publishable (anon) key belongs here, never the secret/service-role key.
# Leave empty to run the app in demo mode without accounts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Optional: TriMTL server URL (defaults to the laptop running Metro, port 3001).
EXPO_PUBLIC_API_URL=
